# SHADOW CODE ENVIRONMENT CONFIGURATION
# Copy to .env for local overrides

# Application Mode: demo | strict | review | live
SHADOW_CODE_MODE=demo
SHADOW_CODE_PORT=8000
SHADOW_CODE_HOST=127.0.0.1
DATABASE_URL=sqlite:///./shadow_code.db

# Optional AI / LLM Integration (Agent 3 - Semantic Reasoner)
# When empty, Agent 3 uses the built-in deterministic AST/semantic reasoning engine
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=

# Optional NVD / CVE RAG Integration (Agent 4 - CVE Correlator)
# When empty, Agent 4 uses the built-in curated CVE knowledge base & local intelligence
NVD_API_KEY=
CHROMA_PERSIST_DIR=./chroma_db

# Optional GitHub Integration (Agent Gateway & Repo Sync)
# Provide personal access token or GitHub App credentials for live repository sync
GITHUB_TOKEN=
GITHUB_REPO_URL=https://github.com/Sachinshekhar82/Shadow-code.git
GITHUB_WEBHOOK_SECRET=
