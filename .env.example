# ==============================================================================
# SHADOW-CODE: AGENTIC AI-POWERED SECURE SDLC AUDITOR CONFIGURATION
# Copy this file to .env or backend/.env and fill in your secrets.
# ==============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Persistent MongoDB Database (MongoDB Atlas connection string or local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
# If unreachable, Shadow-Code automatically activates in-memory mongomock fallback.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=shadow_code

# GitHub Integration
# Personal Access Token (Classic with 'repo' scope or Fine-grained with 'Contents' & 'Pull requests' read/write)
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
GITHUB_REPOSITORY=Sachinshekhar82/Shadow-code
GITHUB_WEBHOOK_SECRET=shadow-code-webhook-secret-here
DEFAULT_REPO_URL=https://github.com/Sachinshekhar82/Shadow-code.git

# Official Google Gemini AI Engine
# Get an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest
LLM_PROVIDER=gemini
MAX_RETRY_LIMIT=3
GEMINI_REQUEST_TIMEOUT_SECONDS=45

# Security Scanner Engine Options
ENABLE_SEMGREP=true
ENABLE_BANDIT=true
SCAN_TIMEOUT_SECONDS=120
